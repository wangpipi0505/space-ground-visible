root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{java,py,ps1}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 读取中文脚本需要 UTF-8 BOM，PowerShell 7 同样兼容。
[*.ps1]
charset = utf-8-bom
