"""六项整体审查发现的限定反例与当前合同核验；只读来源，不执行计算或历史写入入口。"""
import ast
import copy
import importlib.util
import json
import re
import sys
import unittest
from pathlib import Path

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]
OUT = Path(__file__).resolve().parent
GENERATOR = ROOT / 'verification/A02/build_contract.py'
spec = importlib.util.spec_from_file_location('current_contract', GENERATOR)
contract = importlib.util.module_from_spec(spec)
spec.loader.exec_module(contract)
DOC = json.loads((ROOT / 'docs/openapi/openapi.json').read_bytes())
SCHEMAS = DOC['components']['schemas']
MARKDOWN = (ROOT / 'docs/接口文档.md').read_text(encoding='utf-8')
MANUAL = (ROOT / 'docs/软件功能使用说明.md').read_text(encoding='utf-8')
FITTER = (ROOT / 'backend/src/main/java/com/tx/alg/trajectory/TargetTrajectoryFitter.java').read_text(encoding='utf-8')

# 只提取旧核验器的纯校验函数，避免执行其顶层完整扫描及写入validation-result.json。
old = ROOT / 'verification/A02/validate_contract.py'
tree = ast.parse(old.read_text(encoding='utf-8'))
names = {'resolve', 'select_media', 'published_properties', 'source_properties', 'source_field_errors', 'validate', 'refs'}
pure_tree = ast.Module(body=[n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in names], type_ignores=[])
namespace = {'schemas': SCHEMAS, 'contract': contract, 're': re,
             'datetime': __import__('datetime').datetime, 'errors': [], 'checks': {'valueChecks': 0, 'refs': 0}}
exec(compile(pure_tree, str(old), 'exec'), namespace)


def field(owner, name):
    schema = SCHEMAS[owner]
    return schema.get('properties', schema.get('allOf', [{}])[-1].get('properties', {}))[name]


def accepts(value, schema):
    namespace['errors'].clear()
    namespace['validate'](value, schema, 'synthetic')
    errors = list(namespace['errors'])
    if schema.get('type') == 'integer' and isinstance(value, int) and not isinstance(value, bool):
        bits = {'int32': 32, 'int64': 64}.get(schema.get('format'))
        if bits and not (-2 ** (bits - 1) <= value < 2 ** (bits - 1)):
            errors.append('integer format overflow')
    return not errors


class TargetedContract(unittest.TestCase):
    def test_I01_simulation_time_metadata(self):
        for name in ['taskStartTime', 'taskEndTime']:
            with self.subTest(field=name):
                schema = field('SimulationRequest', name)
                self.assertTrue(schema['nullable'])
                for text in ['任务/文件元数据', '非空', '原时间解析', '告警', '命名', '不裁剪或扩展模拟CSV时域']:
                    self.assertIn(text, schema['description'])
                self.assertNotIn('拟合须覆盖', schema['description'])
                self.assertNotIn('输出开始时刻', schema['description'])
                for value in [None, '', ' \t ', '2026-07-01T10:00:00Z', '20260701100000.000', '836100000']:
                    self.assertTrue(accepts(value, schema), repr(value))
                self.assertFalse(accepts(600, schema))
                self.assertIn(schema['description'], MARKDOWN)
                self.assertEqual(contract.meaning(name, 'String', 'SimulationRequest'), schema['description'])
        self.assertIn('if (!isBlank(request.taskStartTime))', FITTER)
        self.assertIn('parseTimeCode(request.taskStartTime)', FITTER)
        self.assertIn('if (!isBlank(request.taskEndTime))', FITTER)
        self.assertIn('parseTimeCode(request.taskEndTime)', FITTER)
        self.assertIn('simulationOutputRelativeTimes(plan.timeOfFlightSec, outputStepSec)', FITTER)
        self.assertTrue('firstNonBlank(request.taskStartTime, request.launchTimeUtc)' in FITTER)
        self.assertTrue('firstNonBlank(request.taskEndTime, request.launchTimeUtc)' in FITTER)

    def test_I01_duration_compatibility(self):
        schema = field('SimulationRequest', 'durationSec')
        self.assertEqual(schema['default'], 600)
        self.assertEqual(schema['type'], 'number')
        self.assertNotIn('nullable', schema)
        self.assertIn('旧兼容数值', schema['description'])
        self.assertIn('当前端点模型不读取', schema['description'])
        self.assertNotIn('共同观测', schema['description'])
        self.assertIn(schema['description'], MARKDOWN)
        for value in [-1, 0, 600, 1200.5]:
            self.assertTrue(accepts(value, schema))
        for value in [None, '600', True]:
            self.assertFalse(accepts(value, schema))
        self.assertNotIn('request.durationSec', FITTER)
        self.assertIn('public double durationSec = 600.0;', FITTER)

    def test_I01_phase_event_is_compatibility_text(self):
        for name in ['startTime', 'endTime']:
            with self.subTest(field=name):
                schema = field('PhaseEvent', name)
                self.assertIn('兼容文本', schema['description'])
                self.assertIn('当前端点模型不读取', schema['description'])
                self.assertIn('不做事件起止顺序业务校验', schema['description'])
                self.assertNotIn('须晚于', schema['description'])
                self.assertIn(schema['description'], MARKDOWN)
                for value in [None, '', ' \t ', '原事件标签', 'not-a-time']:
                    self.assertTrue(accepts(value, schema))
                self.assertFalse(accepts(10, schema))
                self.assertEqual(contract.meaning(name, 'String', 'PhaseEvent'), schema['description'])
        event = {'startTime': 'later-text', 'endTime': 'earlier-text'}
        self.assertTrue(accepts(event, SCHEMAS['PhaseEvent']))
        self.assertIn('request.phaseEvents.size()', FITTER)
        self.assertNotRegex(FITTER, r'(?:event|phaseEvent)\.(?:startTime|endTime)')

    def test_I01_fit_and_space_owner_rules_remain(self):
        self.assertIn('拟合须覆盖首观测', field('FitRequest', 'taskStartTime')['description'])
        self.assertIn('拟合须覆盖末观测', field('FitRequest', 'taskEndTime')['description'])
        self.assertIn('validateTaskWindowCoversObservedIfPresent(taskStartSec, taskEndSec', FITTER)
        self.assertIn('taskEndTime必须晚于taskStartTime', FITTER)
        self.assertIn('共同观测父窗口按成员交集计算', field('VisibilityArc', 'durationSec')['description'])

    def test_I02_endpoint_empty_units_and_frames(self):
        for prefix in ['launch', 'impact']:
            for suffix, fallback in [('PointUnit', 'm'), ('PointCoordFrame', 'J2000')]:
                with self.subTest(field=prefix + suffix):
                    schema = field('SimulationRequest', prefix + suffix)
                    self.assertEqual(schema['default'], fallback)
                    self.assertTrue(schema['nullable'])
                    self.assertEqual(schema['type'], 'string')
                    self.assertIn('缺失/null/空串/空白', schema['description'])
                    self.assertIn('均回退' + fallback, schema['description'])
                    self.assertIn(schema['description'], MARKDOWN)
                    self.assertIn('blankToDefault(request.' + prefix + suffix + ', "' + fallback + '")', FITTER)
                    for value in [None, '', ' \t ', fallback]:
                        self.assertTrue(accepts(value, schema))
                    self.assertFalse(accepts(1, schema))
            unit = field('SimulationRequest', prefix + 'PointUnit')['description']
            for text in ['m/km/0.1m', '数值倍率', '地理框架', '经度°', '纬度°', '高度m', '忽略单位']:
                self.assertIn(text, unit)
        self.assertNotIn('显式空值与缺省不同', MARKDOWN)
        self.assertIn('102端点', MARKDOWN)
        self.assertIn('未给有效单位时为0.1m', MARKDOWN)
        self.assertIn('两种输入的地理框架均忽略单位', MARKDOWN)
        self.assertIn('info.unit = boundaryField(records, launch, "unit");', FITTER)
        block = FITTER.split('private static OrbitCalculator.Vector3 parseBoundaryPositionEci', 1)[1].split('private static String normalizeFrame', 1)[0]
        self.assertLess(block.index('return ecefToEci(geodeticToEcef'), block.index('positionUnitScale(unitText)'))
        self.assertIn('return PACKAGE102_POSITION_UNIT_M;', FITTER)
        self.assertIn('return parseNumeric(unitText);', FITTER)

    def test_M01_manual_button_and_download_success(self):
        row = next(line for line in MANUAL.splitlines() if line.startswith('| 窗口预览/下载404 |'))
        for text in ['该生成页自身', '预览/完整CSV/下载', '辅助错误', 'HTTP 下载原CSV',
                     '下载成功', '实际辅助请求失败', '原CSV仍存在或已恢复', '或重算']:
            self.assertIn(text, row)
        component = (ROOT / 'frontend/src/components/BallisticFitFileResult.vue').read_text(encoding='utf-8')
        self.assertIn('v-if="previewError || trajectoryError || downloadError"', component)
        self.assertIn('downloadError.value = message(failure)', component)
        self.assertIn('saveBallisticBlob(data.blob, data.filename)', component)

    def test_M03_preview_int32_only(self):
        parameters = DOC['paths']['/api/v1/ballistic/files/{fileId}/preview']['get']['parameters']
        for name, default in [('page', 1), ('limit', 50)]:
            with self.subTest(parameter=name):
                schema = next(p['schema'] for p in parameters if p['name'] == name)
                self.assertEqual(schema['format'], 'int32')
                self.assertEqual(schema['default'], default)
                self.assertEqual(schema['minimum'], 1)
                self.assertNotIn('maximum', schema)
                self.assertTrue(accepts(1, schema))
                self.assertTrue(accepts(2147483647, schema))
                for value in [0, -1, 2147483648, '1', None]:
                    self.assertFalse(accepts(value, schema))
        controller = (ROOT / 'backend/src/main/java/com/runisys/orbit/spacevisibility/api/ballistic/BallisticFileController.java').read_text(encoding='utf-8')
        self.assertRegex(controller, r'@RequestParam\(defaultValue = "1"\) int page, @RequestParam\(defaultValue = "50"\) int limit')
        for path in ['/api/v1/space/satellites/page', '/api/v1/space/visibility/task-results']:
            for p in DOC['paths'][path]['get']['parameters']:
                if p['name'] in ['pageNumber', 'pageSize']:
                    self.assertEqual(p['schema']['format'], 'int64')

    def test_M04_station_string_identity(self):
        schema = field('StationEntity', 'id')
        self.assertEqual(schema['type'], 'string')
        self.assertIn('原地面站字符串主键', schema['description'])
        self.assertNotIn('实体响应为 Long 数字', schema['description'])
        self.assertIn(schema['description'], MARKDOWN)
        self.assertIn('卫星/目标目录ID及下传satelliteId为数字', MARKDOWN)
        self.assertIn('stationId保持字符串', MARKDOWN)
        self.assertTrue(accepts('T04-STATION', schema))
        self.assertFalse(accepts(4, schema))
        station = (ROOT / 'backend/src/main/java/com/runisys/orbit/spacevisibility/infrastructure/persistence/entity/StationEntity.java').read_text(encoding='utf-8')
        self.assertIn('private String id;', station)
        self.assertIn('public String getId()', station)

    def test_M02_disclosed_boundaries_remain(self):
        report = (ROOT / 'verification/A01/测试报告.md').read_text(encoding='utf-8')
        for text in ['MVC WebAsyncManager执行器告警', 'Tomcat潜在泄漏WARN', '最高并发只测6',
                     'N10', 'N12', '实际5行', '实际2行', 'SLA', 'MySQL/DM/MinIO/Nginx仍BLOCKED',
                     'SKIP', '长期稳定性', '热卸载']:
            self.assertIn(text, report)
        logs = (ROOT / 'verification/A01/final/server-performance-r2-start-stop.txt').read_text(encoding='utf-8')
        self.assertIn('SimpleAsyncTaskExecutor', logs)
        self.assertIn('space-visibility-1', logs)
        self.assertIn('WARN', logs)

    def test_35_routes_refs_source_fields_and_selected_real_examples(self):
        active = set()
        for path in (contract.SOURCE / 'com/runisys/orbit/spacevisibility/api').rglob('*Controller.java'):
            text = path.read_text(encoding='utf-8')
            prefix = re.search(r'@RequestMapping\("([^\"]+)"\)', text)
            if not prefix:
                continue
            for match in re.finditer(r'@(Get|Post|Put|Delete)Mapping(?:\(([\s\S]*?)\))?\s*', text):
                suffix = re.search(r'"([^\"]+)"', match.group(2) or '')
                active.add(match.group(1).upper() + ' ' + prefix.group(1) + (suffix.group(1) if suffix else ''))
            if 'extends OrbitVisibilityController' in text:
                active.add('GET ' + prefix.group(1) + '/health')
        declared = {m.upper() + ' ' + p for p, ops in DOC['paths'].items() for m in ops}
        self.assertEqual(len(declared), 35)
        self.assertEqual(declared, active)
        self.assertEqual(declared, {r['route'] for r in contract.summary['routeMatrix']})
        namespace['errors'].clear()
        namespace['refs'](DOC)
        self.assertEqual(namespace['errors'], [])
        self.assertEqual(namespace['source_field_errors'](SCHEMAS), [])
        counts = {'operations': 35, 'refs': namespace['checks']['refs'], 'selectedResponses': 0, 'selectedRequests': 0}
        for method, path, _, request, _ in contract.ROUTES:
            operation = DOC['paths'][path][method.lower()]
            for example in contract.EXAMPLES[method + ' ' + path]:
                if example['response'] is not None:
                    _, media = namespace['select_media'](operation['responses'][str(example['event']['status'])].get('content', {}), example['event'].get('headers', {}).get('Content-Type'))
                    self.assertIsNotNone(media)
                    self.assertTrue(accepts(example['response'], media['schema']), namespace['errors'])
                    counts['selectedResponses'] += 1
                if example['event']['status'] < 300 and request and request != 'MultipartUpload' and example['request'] is not None:
                    schema = next(iter(operation['requestBody']['content'].values()))['schema']
                    self.assertTrue(accepts(example['request'], schema), namespace['errors'])
                    counts['selectedRequests'] += 1
        print('LIMITED_COUNTS ' + json.dumps(counts, ensure_ascii=False))

    def test_only_allowed_contract_changes(self):
        baseline = json.loads((OUT / 'history/docs__openapi__openapi.json.before.bin').read_bytes())
        candidate = copy.deepcopy(DOC)
        allowed = {'SimulationRequest': ['taskStartTime', 'taskEndTime', 'durationSec', 'launchPointUnit',
                    'impactPointUnit', 'launchPointCoordFrame', 'impactPointCoordFrame'],
                   'PhaseEvent': ['startTime', 'endTime'], 'StationEntity': ['id']}
        for owner, fields in allowed.items():
            for name in fields:
                candidate['components']['schemas'][owner]['properties'][name]['description'] = baseline['components']['schemas'][owner]['properties'][name]['description']
        path = '/api/v1/ballistic/files/{fileId}/preview'
        for p in candidate['paths'][path]['get']['parameters']:
            if p['name'] in ['page', 'limit']:
                p['schema']['format'] = 'int64'
        self.assertEqual(candidate, baseline)


if __name__ == '__main__':
    sys.stdout.reconfigure(encoding='utf-8')
    sys.stderr.reconfigure(encoding='utf-8')
    unittest.main(verbosity=2)
